{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "jsx": "preserve",
    "jsxImportSource": "@solidtv/solid"
  },
  "include": ["app/**/*"],
  "files": ["./references.d.ts"],
  "exclude": ["node_modules", "platforms"]
}
