{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@tv/*": ["../tv/src/*"],
      "#devices/debug": ["../tv/devices/debug.ts"],
      "#devices/resolution": ["./src/shims/resolution.ts"],
      "#devices/devices": ["../tv/devices/devices.ts"],
      "#device": ["./src/shims/device.ts"],
      "solid-js": ["./node_modules/solid-js"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
