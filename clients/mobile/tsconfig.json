{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "dom"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@nativescript-community/solid-js",
    "paths": {
      "@tv/*": [
        "../tv/src/*"
      ],
      "@appletv/*": [
        "../appletv/app/*"
      ],
      "#device": [
        "./app/shims/device.ts"
      ],
      "#devices/*": [
        "../tv/devices/*"
      ]
    }
  },
  "include": [
    "app/**/*"
  ],
  "files": [
    "./references.d.ts"
  ],
  "exclude": [
    "node_modules",
    "platforms"
  ]
}
