{
  "name": "panda-web",
  "version": "0.1.0",
  "private": true,
  "description": "Panda admin and account web UI (Solid 2)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
