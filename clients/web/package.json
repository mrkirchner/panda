    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8",
    "vitest": "^5.1.1"
  }
}
